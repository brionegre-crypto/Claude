#!/bin/bash
# THE TRUTH LEDGER · a Be The Man daily system
# Puts 49 days of reminders (morning, midday, evening + weekly reviews) into a
# new list in Apple Reminders called "Be The Man: Truth Ledger". It syncs to your iPhone
# through iCloud.
#
# Run it in Terminal:   bash ~/Downloads/install-truth-ledger.command
# Start today instead of tomorrow:   bash ~/Downloads/install-truth-ledger.command today
set -euo pipefail

# Your reminder times (24-hour clock). Change these before running if your day is different.
MORNING="6:30"
MIDDAY="12:30"
EVENING="21:00"
REVIEW="19:00"     # weekly review, every 7th day

START=1                       # Day 1 = tomorrow
[ "${1:-}" = "today" ] && START=0
LIST="Be The Man: Truth Ledger"

if osascript -e "tell application \"Reminders\" to exists list \"$LIST\"" | grep -q true; then
  read -r -p "The list \"$LIST\" already exists. Replace everything in it? (y/n) " ans
  [ "$ans" = "y" ] || { echo "Nothing changed."; exit 0; }
  REPLACE=1
else
  REPLACE=0
fi

echo "Adding 156 reminders to \"$LIST\". This takes a minute or two. Leave Reminders alone until it finishes…"
osascript - "$START" "$REPLACE" "$LIST" "$MORNING" "$MIDDAY" "$EVENING" "$REVIEW" <<'APPLESCRIPT'
property startOffset : 1
property listName : ""
property slotNames : {"morning", "midday", "evening", "review"}
property slotTimes : {}

on hm(s)
  set AppleScript's text item delimiters to ":"
  set p to text items of s
  set AppleScript's text item delimiters to ""
  return (((item 1 of p) as integer) * hours) + (((item 2 of p) as integer) * minutes)
end hm

on dayAt(n, secs)
  -- noon on the target day so daylight-saving changes can't push it to the wrong date
  set d to (current date)
  set time of d to 12 * hours
  set d to d + (startOffset + n - 1) * days
  set time of d to secs
  return d
end dayAt

on addOne(n, slot, theName, theBody)
  set secs to 0
  repeat with i from 1 to 4
    if item i of slotNames is slot then set secs to item i of slotTimes
  end repeat
  set d to my dayAt(n, secs)
  tell application "Reminders" to tell list listName
    try
      make new reminder with properties {name:theName, body:theBody, due date:d, remind me date:d}
    on error
      make new reminder with properties {name:theName, body:theBody, due date:d}
    end try
  end tell
end addOne

on run argv
  set startOffset to (item 1 of argv) as integer
  set replaceIt to (item 2 of argv) as integer
  set listName to item 3 of argv
  set slotTimes to {my hm(item 4 of argv), my hm(item 5 of argv), my hm(item 6 of argv), my hm(item 7 of argv)}
  tell application "Reminders"
    if replaceIt is 1 then
      delete (every reminder of list listName)
    else
      make new list with properties {name:listName}
    end if
  end tell
  -- Day 0: tonight, ten minutes from now
  set t to (current date) + 10 * minutes
  tell application "Reminders" to tell list listName to make new reminder with properties {name:"Day 0 Tonight: start here", body:"TONIGHT, BEFORE YOU SLEEP (30 min)\n1. Write one sentence: \"I am a man whose word holds, even when the truth costs me.\"\n2. Count honestly: roughly how many lies did you tell this week? Write the number.\n3. Write two names: one man to be your accountability brother, and a pastor or older man you respect to be your witness. You'll ask them by Day 3.\n4. Text your brother now: \"I'm working on something. Can I send you my numbers once a week?\"\n5. If she's open to it, tell your wife: \"I've lied to you, and it comes from fear. I'm not asking you to trust me. I've started daily work and I'm getting men around me to hold me to it. You'll see it, not just hear it.\"\nThen do not tell another lie tonight.", due date:t, remind me date:t}
  my addOne(1, "morning", "Day 1 Morning: The count begins", "Week 1: See It. You can't fix what you won't count.\n\nToday you only count. Every lie, every exaggeration, every \"yeah, I did\" that wasn't true. No fixing, no beating yourself up. Keep a tally in your phone notes as it happens.\n\nBefore you go, write today's if-then: \"If ___ happens, then I'll say ___.\"\n\nWhy it works: Tracking your behavior changes your behavior. The nightly ledger is the written record. The weekly text with your numbers to your accountability brother is the reporting. (Harkin et al. (2016), Psychological Bulletin)")
  my addOne(1, "midday", "Day 1 Midday check", "Anything to correct since this morning? Correct it before 5 PM: \"Actually, that's not true. The truth is ___.\" Then log it tonight.")
  my addOne(1, "evening", "Day 1 Evening Ledger", "Tonight's question: How many did you log? Which one surprised you most, and why?\n\nTHE LEDGER (10 min)\n1. Lies told today (#): what, to whom\n2. Lies caught before I spoke (#)\n3. Corrections made (#)\n4. The trigger: who, where, how tired I was, and the fear (failure / rejection / conflict / looking weak)\n5. The story in my head: \"If I tell the truth, ___ will happen.\"\n6. What actually happened when I told the truth\n7. Tomorrow's risk moment, written as an if-then: \"If ___, then I'll say ___.\"\n8. One line of prayer or thanks")
  my addOne(2, "morning", "Day 2 Morning: Name the kind", "Week 1: See It. You can't fix what you won't count.\n\nTag each lie today by type. COVER: hiding a mistake. INFLATE: looking better than you are. SMOOTH: avoiding conflict. AUTO: no reason at all, it just came out.\n\nBefore you go, write today's if-then: \"If ___ happens, then I'll say ___.\"\n\nWhy it works: Most lies come from a small group of people. Lying a lot is a pattern, not human nature. Patterns can be counted and changed. That's why Week 1 is counting. (Serota, Levine & Boster (2010), Human Communication Research)")
  my addOne(2, "midday", "Day 2 Midday check", "Anything to correct since this morning? Correct it before 5 PM: \"Actually, that's not true. The truth is ___.\" Then log it tonight.")
  my addOne(2, "evening", "Day 2 Evening Ledger", "Tonight's question: Which type showed up most? What does that tell you that you're protecting?\n\nTHE LEDGER (10 min)\n1. Lies told today (#): what, to whom\n2. Lies caught before I spoke (#)\n3. Corrections made (#)\n4. The trigger: who, where, how tired I was, and the fear (failure / rejection / conflict / looking weak)\n5. The story in my head: \"If I tell the truth, ___ will happen.\"\n6. What actually happened when I told the truth\n7. Tomorrow's risk moment, written as an if-then: \"If ___, then I'll say ___.\"\n8. One line of prayer or thanks")
  my addOne(3, "morning", "Day 3 Morning: Build your corner", "Week 1: See It. You can't fix what you won't count.\n\nAction before noon: ask the men who will be in your corner. 1) Your accountability brother, who gets your numbers every week. 2) Your witness: your pastor or an older man you respect, who will hear your inventory and help you prepare to tell your wife. 3) A free group if one is near you, like Celebrate Recovery or a church men's group. If your job (or your wife's) has an Employee Assistance Program, call it today. Most offer a few free, confidential counseling sessions.\n\nBefore you go, write today's if-then: \"If ___ happens, then I'll say ___.\"\n\nWhy it works: Self-guided CBT can work as well as sessions with a therapist. You can do this work without paying a counselor, but not alone. The \"guided\" part matters: your brother, your witness and your group keep you from quitting. (Cuijpers et al. (2010), Psychological Medicine)")
  my addOne(3, "midday", "Day 3 Midday check", "Anything to correct since this morning? Correct it before 5 PM: \"Actually, that's not true. The truth is ___.\" Then log it tonight.")
  my addOne(3, "evening", "Day 3 Evening Ledger", "Tonight's question: Who said yes? If someone is missing, what did you tell yourself about why you can't ask, and was that true?\n\nTHE LEDGER (10 min)\n1. Lies told today (#): what, to whom\n2. Lies caught before I spoke (#)\n3. Corrections made (#)\n4. The trigger: who, where, how tired I was, and the fear (failure / rejection / conflict / looking weak)\n5. The story in my head: \"If I tell the truth, ___ will happen.\"\n6. What actually happened when I told the truth\n7. Tomorrow's risk moment, written as an if-then: \"If ___, then I'll say ___.\"\n8. One line of prayer or thanks")
  my addOne(4, "morning", "Day 4 Morning: Who gets the lies", "Week 1: See It. You can't fix what you won't count.\n\nNotice who you lie to most. Write their names as it happens: wife, boss, kids, friends, parents, yourself.\n\nBefore you go, write today's if-then: \"If ___ happens, then I'll say ___.\"\n\nWhy it works: Trying to look competent or likable makes people lie more. Your two fears, failing and not being accepted, are exactly these two goals. Week 2 teaches you to notice which one is running in the moment. (Feldman, Forrest & Happ (2002), Basic and Applied Social Psychology)")
  my addOne(4, "midday", "Day 4 Midday check", "Anything to correct since this morning? Correct it before 5 PM: \"Actually, that's not true. The truth is ___.\" Then log it tonight.")
  my addOne(4, "evening", "Day 4 Evening Ledger", "Tonight's question: Who is it hardest to tell the truth to? What do you fear they'll think of you?\n\nTHE LEDGER (10 min)\n1. Lies told today (#): what, to whom\n2. Lies caught before I spoke (#)\n3. Corrections made (#)\n4. The trigger: who, where, how tired I was, and the fear (failure / rejection / conflict / looking weak)\n5. The story in my head: \"If I tell the truth, ___ will happen.\"\n6. What actually happened when I told the truth\n7. Tomorrow's risk moment, written as an if-then: \"If ___, then I'll say ___.\"\n8. One line of prayer or thanks")
  my addOne(5, "morning", "Day 5 Morning: The alarm in your body", "Week 1: See It. You can't fix what you won't count.\n\nNotice what your body does right before a lie: tight chest, hot face, dry throat, talking faster. That feeling is your alarm. Learn it today.\n\nBefore you go, write today's if-then: \"If ___ happens, then I'll say ___.\"\n\nWhy it works: Break an automatic habit: notice it, then replace it. Day 5 teaches you your body's alarm. The pause and a prepared true sentence are the replacement response. Your brother is the support. (Bate, Malouff, Thorsteinsson & Bhullar (2011), Clinical Psychology Review (meta-analysis))")
  my addOne(5, "midday", "Day 5 Midday check", "Anything to correct since this morning? Correct it before 5 PM: \"Actually, that's not true. The truth is ___.\" Then log it tonight.")
  my addOne(5, "evening", "Day 5 Evening Ledger", "Tonight's question: Describe your alarm. How many seconds were there between the alarm and the lie?\n\nTHE LEDGER (10 min)\n1. Lies told today (#): what, to whom\n2. Lies caught before I spoke (#)\n3. Corrections made (#)\n4. The trigger: who, where, how tired I was, and the fear (failure / rejection / conflict / looking weak)\n5. The story in my head: \"If I tell the truth, ___ will happen.\"\n6. What actually happened when I told the truth\n7. Tomorrow's risk moment, written as an if-then: \"If ___, then I'll say ___.\"\n8. One line of prayer or thanks")
  my addOne(6, "morning", "Day 6 Morning: The cost", "Week 1: See It. You can't fix what you won't count.\n\nWrite a specific list of what lying has cost you: trust, peace, money, time, intimacy, sleep, respect for yourself. Names and moments, not general ideas.\n\nBefore you go, write today's if-then: \"If ___ happens, then I'll say ___.\"\n\nWhy it works: Lying less goes with better health and relationships. The payoff of this work isn't only your marriage. You should also start to feel better. (Kelly & Wang (2012), American Psychological Association convention)")
  my addOne(6, "midday", "Day 6 Midday check", "Anything to correct since this morning? Correct it before 5 PM: \"Actually, that's not true. The truth is ___.\" Then log it tonight.")
  my addOne(6, "evening", "Day 6 Evening Ledger", "Tonight's question: Which cost are you no longer willing to pay?\n\nTHE LEDGER (10 min)\n1. Lies told today (#): what, to whom\n2. Lies caught before I spoke (#)\n3. Corrections made (#)\n4. The trigger: who, where, how tired I was, and the fear (failure / rejection / conflict / looking weak)\n5. The story in my head: \"If I tell the truth, ___ will happen.\"\n6. What actually happened when I told the truth\n7. Tomorrow's risk moment, written as an if-then: \"If ___, then I'll say ___.\"\n8. One line of prayer or thanks")
  my addOne(7, "morning", "Day 7 Morning: Week 1 review", "Week 1: See It. You can't fix what you won't count.\n\nTonight is your first weekly review. Today, keep counting. Also pick your accountability brother: one man you will text your numbers to every week.\n\nBefore you go, write today's if-then: \"If ___ happens, then I'll say ___.\"\n\nWhy it works: Tracking your behavior changes your behavior. The nightly ledger is the written record. The weekly text with your numbers to your accountability brother is the reporting. (Harkin et al. (2016), Psychological Bulletin)")
  my addOne(7, "midday", "Day 7 Midday check", "Anything to correct since this morning? Correct it before 5 PM: \"Actually, that's not true. The truth is ___.\" Then log it tonight.")
  my addOne(7, "review", "Week 1 review", "WEEKLY REVIEW (20 min)\nAdd up this week's ledgers: lies told, lies caught, corrections made. Text the three numbers to your brother. Share the week's patterns with your witness.\n\nNext week: The Fear Underneath. You told us why you lie: fear of failing and fear of not being accepted. This week you find exactly where those fears live and what they've been buying you.")
  my addOne(7, "evening", "Day 7 Evening Ledger", "Tonight's question: Total the week: lies told, caught, corrected. Text your brother the three numbers with no excuses attached. What pattern do you see?\n\nTHE LEDGER (10 min)\n1. Lies told today (#): what, to whom\n2. Lies caught before I spoke (#)\n3. Corrections made (#)\n4. The trigger: who, where, how tired I was, and the fear (failure / rejection / conflict / looking weak)\n5. The story in my head: \"If I tell the truth, ___ will happen.\"\n6. What actually happened when I told the truth\n7. Tomorrow's risk moment, written as an if-then: \"If ___, then I'll say ___.\"\n8. One line of prayer or thanks")
  my addOne(8, "morning", "Day 8 Morning: The fear of failing", "Week 2: The Fear Underneath. Every lie is protecting something.\n\nEach time you feel the urge to lie today, ask yourself: \"Am I hiding that I failed?\"\n\nBefore you go, write today's if-then: \"If ___ happens, then I'll say ___.\"\n\nWhy it works: Trying to look competent or likable makes people lie more. Your two fears, failing and not being accepted, are exactly these two goals. Week 2 teaches you to notice which one is running in the moment. (Feldman, Forrest & Happ (2002), Basic and Applied Social Psychology)")
  my addOne(8, "midday", "Day 8 Midday check", "Anything to correct since this morning? Correct it before 5 PM: \"Actually, that's not true. The truth is ___.\" Then log it tonight.")
  my addOne(8, "evening", "Day 8 Evening Ledger", "Tonight's question: What failure are you most ashamed for people to see? Where did you learn that failing makes you less of a man?\n\nTHE LEDGER (10 min)\n1. Lies told today (#): what, to whom\n2. Lies caught before I spoke (#)\n3. Corrections made (#)\n4. The trigger: who, where, how tired I was, and the fear (failure / rejection / conflict / looking weak)\n5. The story in my head: \"If I tell the truth, ___ will happen.\"\n6. What actually happened when I told the truth\n7. Tomorrow's risk moment, written as an if-then: \"If ___, then I'll say ___.\"\n8. One line of prayer or thanks")
  my addOne(9, "morning", "Day 9 Morning: The fear of not being accepted", "Week 2: The Fear Underneath. Every lie is protecting something.\n\nEach time the urge hits, ask yourself: \"Am I trying to be liked right now?\"\n\nBefore you go, write today's if-then: \"If ___ happens, then I'll say ___.\"\n\nWhy it works: Trying to look competent or likable makes people lie more. Your two fears, failing and not being accepted, are exactly these two goals. Week 2 teaches you to notice which one is running in the moment. (Feldman, Forrest & Happ (2002), Basic and Applied Social Psychology)")
  my addOne(9, "midday", "Day 9 Midday check", "Anything to correct since this morning? Correct it before 5 PM: \"Actually, that's not true. The truth is ___.\" Then log it tonight.")
  my addOne(9, "evening", "Day 9 Evening Ledger", "Tonight's question: Finish this sentence ten times without stopping: \"If they knew the real me, they would...\"\n\nTHE LEDGER (10 min)\n1. Lies told today (#): what, to whom\n2. Lies caught before I spoke (#)\n3. Corrections made (#)\n4. The trigger: who, where, how tired I was, and the fear (failure / rejection / conflict / looking weak)\n5. The story in my head: \"If I tell the truth, ___ will happen.\"\n6. What actually happened when I told the truth\n7. Tomorrow's risk moment, written as an if-then: \"If ___, then I'll say ___.\"\n8. One line of prayer or thanks")
  my addOne(10, "morning", "Day 10 Morning: Where it started", "Week 2: The Fear Underneath. Every lie is protecting something.\n\nAt some point today, think back to the first time you remember lying to stay safe. Who were you protecting yourself from?\n\nBefore you go, write today's if-then: \"If ___ happens, then I'll say ___.\"\n\nWhy it works: Writing about hard things helps a little. The evening questions and letters are writing exercises. They help, but they're one tool among several, not a cure. (Frattaroli (2006), Psychological Bulletin)")
  my addOne(10, "midday", "Day 10 Midday check", "Anything to correct since this morning? Correct it before 5 PM: \"Actually, that's not true. The truth is ___.\" Then log it tonight.")
  my addOne(10, "evening", "Day 10 Evening Ledger", "Tonight's question: Write that boy a short letter. What did he need to hear that he never heard? Read it to your witness this week.\n\nTHE LEDGER (10 min)\n1. Lies told today (#): what, to whom\n2. Lies caught before I spoke (#)\n3. Corrections made (#)\n4. The trigger: who, where, how tired I was, and the fear (failure / rejection / conflict / looking weak)\n5. The story in my head: \"If I tell the truth, ___ will happen.\"\n6. What actually happened when I told the truth\n7. Tomorrow's risk moment, written as an if-then: \"If ___, then I'll say ___.\"\n8. One line of prayer or thanks")
  my addOne(11, "morning", "Day 11 Morning: Shame vs. guilt", "Week 2: The Fear Underneath. Every lie is protecting something.\n\nGuilt says \"I did something wrong.\" Shame says \"I am wrong.\" Shame drives lies. Catch shame talk in your head today and write it down.\n\nBefore you go, write today's if-then: \"If ___ happens, then I'll say ___.\"\n\nWhy it works: Shame hides. Guilt repairs. Day 11 teaches you to turn shame sentences into guilt sentences. You can repair something you did. You can't repair who you are. (Tangney & Dearing, Shame and Guilt (2002) and later reviews)")
  my addOne(11, "midday", "Day 11 Midday check", "Anything to correct since this morning? Correct it before 5 PM: \"Actually, that's not true. The truth is ___.\" Then log it tonight.")
  my addOne(11, "evening", "Day 11 Evening Ledger", "Tonight's question: Rewrite one shame sentence as a guilt sentence: \"I did ___, and I can make it right by ___.\"\n\nTHE LEDGER (10 min)\n1. Lies told today (#): what, to whom\n2. Lies caught before I spoke (#)\n3. Corrections made (#)\n4. The trigger: who, where, how tired I was, and the fear (failure / rejection / conflict / looking weak)\n5. The story in my head: \"If I tell the truth, ___ will happen.\"\n6. What actually happened when I told the truth\n7. Tomorrow's risk moment, written as an if-then: \"If ___, then I'll say ___.\"\n8. One line of prayer or thanks")
  my addOne(12, "morning", "Day 12 Morning: Test your prediction", "Week 2: The Fear Underneath. Every lie is protecting something.\n\nRun an experiment. Before one hard truth today, write your prediction first: \"If I say it, ___ will happen.\" Then say it.\n\nBefore you go, write today's if-then: \"If ___ happens, then I'll say ___.\"\n\nWhy it works: Lies are safety behaviors. Dropping them teaches you that the truth is survivable. Each lie you don't tell is a test of your prediction. The truth ladder (Week 4) and the prediction test (Day 12) are behavioral experiments. (Clark & Wells cognitive model; Morgan & Raffle (1999); Salkovskis)")
  my addOne(12, "midday", "Day 12 Midday check", "Anything to correct since this morning? Correct it before 5 PM: \"Actually, that's not true. The truth is ___.\" Then log it tonight.")
  my addOne(12, "evening", "Day 12 Evening Ledger", "Tonight's question: Did the prediction come true? Score it: worse, the same, or better than you predicted.\n\nTHE LEDGER (10 min)\n1. Lies told today (#): what, to whom\n2. Lies caught before I spoke (#)\n3. Corrections made (#)\n4. The trigger: who, where, how tired I was, and the fear (failure / rejection / conflict / looking weak)\n5. The story in my head: \"If I tell the truth, ___ will happen.\"\n6. What actually happened when I told the truth\n7. Tomorrow's risk moment, written as an if-then: \"If ___, then I'll say ___.\"\n8. One line of prayer or thanks")
  my addOne(13, "morning", "Day 13 Morning: What lying pays you", "Week 2: The Fear Underneath. Every lie is protecting something.\n\nBe honest: lying pays. It buys relief, approval, time and escape. Each time today, name the payoff you were after.\n\nBefore you go, write today's if-then: \"If ___ happens, then I'll say ___.\"\n\nWhy it works: Compulsive lying is real, and there is no proven cure yet. This guide is built from CBT tools that work for similar problems. It is a structure for doing the work, and you do it with men in your corner, not alone. (Curtis & Hart (2020), Psychiatric Research and Clinical Practice)")
  my addOne(13, "midday", "Day 13 Midday check", "Anything to correct since this morning? Correct it before 5 PM: \"Actually, that's not true. The truth is ___.\" Then log it tonight.")
  my addOne(13, "evening", "Day 13 Evening Ledger", "Tonight's question: Which payoff will you have to grieve to give this up?\n\nTHE LEDGER (10 min)\n1. Lies told today (#): what, to whom\n2. Lies caught before I spoke (#)\n3. Corrections made (#)\n4. The trigger: who, where, how tired I was, and the fear (failure / rejection / conflict / looking weak)\n5. The story in my head: \"If I tell the truth, ___ will happen.\"\n6. What actually happened when I told the truth\n7. Tomorrow's risk moment, written as an if-then: \"If ___, then I'll say ___.\"\n8. One line of prayer or thanks")
  my addOne(14, "morning", "Day 14 Morning: Week 2 review: your Fear Map", "Week 2: The Fear Underneath. Every lie is protecting something.\n\nToday, draw your Fear Map: your top three fears, the lie each one produces, and the truth each one avoids. Share it with your witness.\n\nBefore you go, write today's if-then: \"If ___ happens, then I'll say ___.\"\n\nWhy it works: Lies are safety behaviors. Dropping them teaches you that the truth is survivable. Each lie you don't tell is a test of your prediction. The truth ladder (Week 4) and the prediction test (Day 12) are behavioral experiments. (Clark & Wells cognitive model; Morgan & Raffle (1999); Salkovskis)")
  my addOne(14, "midday", "Day 14 Midday check", "Anything to correct since this morning? Correct it before 5 PM: \"Actually, that's not true. The truth is ___.\" Then log it tonight.")
  my addOne(14, "review", "Week 2 review", "WEEKLY REVIEW (20 min)\nAdd up this week's ledgers: lies told, lies caught, corrections made. Text the three numbers to your brother. Share the week's patterns with your witness.\n\nNext week: The Pause. The lie usually leaves your mouth before you've decided anything. This week you build the gap between the urge and the words, and you fill it with true sentences you've written ahead of time.")
  my addOne(14, "evening", "Day 14 Evening Ledger", "Tonight's question: Total the week and text your brother. Compare it with Week 1. Which fear on the map is running your life the most?\n\nTHE LEDGER (10 min)\n1. Lies told today (#): what, to whom\n2. Lies caught before I spoke (#)\n3. Corrections made (#)\n4. The trigger: who, where, how tired I was, and the fear (failure / rejection / conflict / looking weak)\n5. The story in my head: \"If I tell the truth, ___ will happen.\"\n6. What actually happened when I told the truth\n7. Tomorrow's risk moment, written as an if-then: \"If ___, then I'll say ___.\"\n8. One line of prayer or thanks")
  my addOne(15, "morning", "Day 15 Morning: The three-second pause", "Week 3: The Pause. Lies are fast. Truth needs three seconds.\n\nPractice the sequence: alarm, breath, \"Give me a second.\" Use it at least once today, even in a conversation that's easy.\n\nBefore you go, write today's if-then: \"If ___ happens, then I'll say ___.\"\n\nWhy it works: The pause interrupts an automatic response. The three-second pause isn't magic. It's the gap where your prepared true sentence gets a chance. (Kobis et al. (2019), Perspectives on Psychological Science; Curtis & Hart (2020))")
  my addOne(15, "midday", "Day 15 Midday check", "Anything to correct since this morning? Correct it before 5 PM: \"Actually, that's not true. The truth is ___.\" Then log it tonight.")
  my addOne(15, "evening", "Day 15 Evening Ledger", "Tonight's question: How many times did you pause? What happened in those three seconds?\n\nTHE LEDGER (10 min)\n1. Lies told today (#): what, to whom\n2. Lies caught before I spoke (#)\n3. Corrections made (#)\n4. The trigger: who, where, how tired I was, and the fear (failure / rejection / conflict / looking weak)\n5. The story in my head: \"If I tell the truth, ___ will happen.\"\n6. What actually happened when I told the truth\n7. Tomorrow's risk moment, written as an if-then: \"If ___, then I'll say ___.\"\n8. One line of prayer or thanks")
  my addOne(16, "morning", "Day 16 Morning: \"I don't know\"", "Week 3: The Pause. Lies are fast. Truth needs three seconds.\n\nSay \"I don't know\" or \"I'm not sure\" at least once today instead of filling the silence with something you made up.\n\nBefore you go, write today's if-then: \"If ___ happens, then I'll say ___.\"\n\nWhy it works: Lies are safety behaviors. Dropping them teaches you that the truth is survivable. Each lie you don't tell is a test of your prediction. The truth ladder (Week 4) and the prediction test (Day 12) are behavioral experiments. (Clark & Wells cognitive model; Morgan & Raffle (1999); Salkovskis)")
  my addOne(16, "midday", "Day 16 Midday check", "Anything to correct since this morning? Correct it before 5 PM: \"Actually, that's not true. The truth is ___.\" Then log it tonight.")
  my addOne(16, "evening", "Day 16 Evening Ledger", "Tonight's question: How did it feel not to have an answer? Did anyone actually think less of you?\n\nTHE LEDGER (10 min)\n1. Lies told today (#): what, to whom\n2. Lies caught before I spoke (#)\n3. Corrections made (#)\n4. The trigger: who, where, how tired I was, and the fear (failure / rejection / conflict / looking weak)\n5. The story in my head: \"If I tell the truth, ___ will happen.\"\n6. What actually happened when I told the truth\n7. Tomorrow's risk moment, written as an if-then: \"If ___, then I'll say ___.\"\n8. One line of prayer or thanks")
  my addOne(17, "morning", "Day 17 Morning: The 60-second correction", "Week 3: The Pause. Lies are fast. Truth needs three seconds.\n\nIf a lie slips out, correct it inside a minute: \"Actually, that's not true. The truth is ___.\" Fast correction beats a perfect record.\n\nBefore you go, write today's if-then: \"If ___ happens, then I'll say ___.\"\n\nWhy it works: A slip doesn't have to become a relapse. If you lie, you correct it, log it, tell your brother, and keep going. You never go back to Day 1. (Marlatt & Gordon, Relapse Prevention; Larimer, Palmer & Marlatt (1999))")
  my addOne(17, "midday", "Day 17 Midday check", "Anything to correct since this morning? Correct it before 5 PM: \"Actually, that's not true. The truth is ___.\" Then log it tonight.")
  my addOne(17, "evening", "Day 17 Evening Ledger", "Tonight's question: Did you correct one? If not, which lie from today can you still correct tomorrow? Put it on tomorrow's list.\n\nTHE LEDGER (10 min)\n1. Lies told today (#): what, to whom\n2. Lies caught before I spoke (#)\n3. Corrections made (#)\n4. The trigger: who, where, how tired I was, and the fear (failure / rejection / conflict / looking weak)\n5. The story in my head: \"If I tell the truth, ___ will happen.\"\n6. What actually happened when I told the truth\n7. Tomorrow's risk moment, written as an if-then: \"If ___, then I'll say ___.\"\n8. One line of prayer or thanks")
  my addOne(18, "morning", "Day 18 Morning: Write your if-then plans", "Week 3: The Pause. Lies are fast. Truth needs three seconds.\n\nWrite five if-then plans for your five most common lie situations: \"If she asks whether I finished it, then I say exactly how far I got.\" \"If someone asks what I paid, then I say the real number.\" Save them in your phone.\n\nBefore you go, write today's if-then: \"If ___ happens, then I'll say ___.\"\n\nWhy it works: If-then plans work. Every morning you write one if-then plan for the day's risk moment: \"If she asks about the money, then I'll say the real number.\" (Gollwitzer & Sheeran (2006), Advances in Experimental Social Psychology)")
  my addOne(18, "midday", "Day 18 Midday check", "Anything to correct since this morning? Correct it before 5 PM: \"Actually, that's not true. The truth is ___.\" Then log it tonight.")
  my addOne(18, "evening", "Day 18 Evening Ledger", "Tonight's question: Which script is hardest to say out loud? Say it out loud right now, three times.\n\nTHE LEDGER (10 min)\n1. Lies told today (#): what, to whom\n2. Lies caught before I spoke (#)\n3. Corrections made (#)\n4. The trigger: who, where, how tired I was, and the fear (failure / rejection / conflict / looking weak)\n5. The story in my head: \"If I tell the truth, ___ will happen.\"\n6. What actually happened when I told the truth\n7. Tomorrow's risk moment, written as an if-then: \"If ___, then I'll say ___.\"\n8. One line of prayer or thanks")
  my addOne(19, "morning", "Day 19 Morning: Slow down", "Week 3: The Pause. Lies are fast. Truth needs three seconds.\n\nIn every hard conversation today, speak about 20% slower. Rushing feeds lies.\n\nBefore you go, write today's if-then: \"If ___ happens, then I'll say ___.\"\n\nWhy it works: Break an automatic habit: notice it, then replace it. Day 5 teaches you your body's alarm. The pause and a prepared true sentence are the replacement response. Your brother is the support. (Bate, Malouff, Thorsteinsson & Bhullar (2011), Clinical Psychology Review (meta-analysis))")
  my addOne(19, "midday", "Day 19 Midday check", "Anything to correct since this morning? Correct it before 5 PM: \"Actually, that's not true. The truth is ___.\" Then log it tonight.")
  my addOne(19, "evening", "Day 19 Evening Ledger", "Tonight's question: Where did slowing down change what came out of your mouth?\n\nTHE LEDGER (10 min)\n1. Lies told today (#): what, to whom\n2. Lies caught before I spoke (#)\n3. Corrections made (#)\n4. The trigger: who, where, how tired I was, and the fear (failure / rejection / conflict / looking weak)\n5. The story in my head: \"If I tell the truth, ___ will happen.\"\n6. What actually happened when I told the truth\n7. Tomorrow's risk moment, written as an if-then: \"If ___, then I'll say ___.\"\n8. One line of prayer or thanks")
  my addOne(20, "morning", "Day 20 Morning: No rounding up", "Week 3: The Pause. Lies are fast. Truth needs three seconds.\n\nToday, nothing gets inflated: not numbers, times, effort or stories. Small lies make the brain's alarm quieter, which makes the next lie bigger. Exact is the goal.\n\nBefore you go, write today's if-then: \"If ___ happens, then I'll say ___.\"\n\nWhy it works: Small lies make bigger lies easier. There's no such thing as a harmless small lie for you. Every exaggeration trains the slope. That's why Day 20 is \"No rounding up.\" (Garrett, Lazzaro, Ariely & Sharot (2016), Nature Neuroscience)")
  my addOne(20, "midday", "Day 20 Midday check", "Anything to correct since this morning? Correct it before 5 PM: \"Actually, that's not true. The truth is ___.\" Then log it tonight.")
  my addOne(20, "evening", "Day 20 Evening Ledger", "Tonight's question: Where did you want to round up? Who were you trying to be in that moment?\n\nTHE LEDGER (10 min)\n1. Lies told today (#): what, to whom\n2. Lies caught before I spoke (#)\n3. Corrections made (#)\n4. The trigger: who, where, how tired I was, and the fear (failure / rejection / conflict / looking weak)\n5. The story in my head: \"If I tell the truth, ___ will happen.\"\n6. What actually happened when I told the truth\n7. Tomorrow's risk moment, written as an if-then: \"If ___, then I'll say ___.\"\n8. One line of prayer or thanks")
  my addOne(21, "morning", "Day 21 Morning: Week 3 review", "Week 3: The Pause. Lies are fast. Truth needs three seconds.\n\nRead your if-then plans once this morning. Talk with your witness about whether it's time to offer your wife your weekly numbers. If it is, ask her whether she wants them.\n\nBefore you go, write today's if-then: \"If ___ happens, then I'll say ___.\"\n\nWhy it works: Tracking your behavior changes your behavior. The nightly ledger is the written record. The weekly text with your numbers to your accountability brother is the reporting. (Harkin et al. (2016), Psychological Bulletin)")
  my addOne(21, "midday", "Day 21 Midday check", "Anything to correct since this morning? Correct it before 5 PM: \"Actually, that's not true. The truth is ___.\" Then log it tonight.")
  my addOne(21, "review", "Week 3 review", "WEEKLY REVIEW (20 min)\nAdd up this week's ledgers: lies told, lies caught, corrections made. Text the three numbers to your brother. Share the week's patterns with your witness.\n\nNext week: Small Truths, Out Loud. Counselors call this exposure: you practice the thing you fear in small, planned steps until your body learns that the truth doesn't kill you.")
  my addOne(21, "evening", "Day 21 Evening Ledger", "Tonight's question: Total the week and text your brother. Is your pause count going up while your lie count goes down?\n\nTHE LEDGER (10 min)\n1. Lies told today (#): what, to whom\n2. Lies caught before I spoke (#)\n3. Corrections made (#)\n4. The trigger: who, where, how tired I was, and the fear (failure / rejection / conflict / looking weak)\n5. The story in my head: \"If I tell the truth, ___ will happen.\"\n6. What actually happened when I told the truth\n7. Tomorrow's risk moment, written as an if-then: \"If ___, then I'll say ___.\"\n8. One line of prayer or thanks")
  my addOne(22, "morning", "Day 22 Morning: Build your truth ladder", "Week 4: Small Truths, Out Loud. Courage is a muscle. Train it light first.\n\nList ten truths you've been avoiding, from easiest (\"I'm running late\") to hardest. Today, tell the easiest one.\n\nBefore you go, write today's if-then: \"If ___ happens, then I'll say ___.\"\n\nWhy it works: Lies are safety behaviors. Dropping them teaches you that the truth is survivable. Each lie you don't tell is a test of your prediction. The truth ladder (Week 4) and the prediction test (Day 12) are behavioral experiments. (Clark & Wells cognitive model; Morgan & Raffle (1999); Salkovskis)")
  my addOne(22, "midday", "Day 22 Midday check", "Anything to correct since this morning? Correct it before 5 PM: \"Actually, that's not true. The truth is ___.\" Then log it tonight.")
  my addOne(22, "evening", "Day 22 Evening Ledger", "Tonight's question: Rate your fear from 0 to 10 before you said it and after. What changed?\n\nTHE LEDGER (10 min)\n1. Lies told today (#): what, to whom\n2. Lies caught before I spoke (#)\n3. Corrections made (#)\n4. The trigger: who, where, how tired I was, and the fear (failure / rejection / conflict / looking weak)\n5. The story in my head: \"If I tell the truth, ___ will happen.\"\n6. What actually happened when I told the truth\n7. Tomorrow's risk moment, written as an if-then: \"If ___, then I'll say ___.\"\n8. One line of prayer or thanks")
  my addOne(23, "morning", "Day 23 Morning: Disappoint someone on purpose", "Week 4: Small Truths, Out Loud. Courage is a muscle. Train it light first.\n\nSay one honest \"no\" or \"I can't\" today with no made-up excuse attached.\n\nBefore you go, write today's if-then: \"If ___ happens, then I'll say ___.\"\n\nWhy it works: Lies are safety behaviors. Dropping them teaches you that the truth is survivable. Each lie you don't tell is a test of your prediction. The truth ladder (Week 4) and the prediction test (Day 12) are behavioral experiments. (Clark & Wells cognitive model; Morgan & Raffle (1999); Salkovskis)")
  my addOne(23, "midday", "Day 23 Midday check", "Anything to correct since this morning? Correct it before 5 PM: \"Actually, that's not true. The truth is ___.\" Then log it tonight.")
  my addOne(23, "evening", "Day 23 Evening Ledger", "Tonight's question: What happened? Did the relationship survive the truth?\n\nTHE LEDGER (10 min)\n1. Lies told today (#): what, to whom\n2. Lies caught before I spoke (#)\n3. Corrections made (#)\n4. The trigger: who, where, how tired I was, and the fear (failure / rejection / conflict / looking weak)\n5. The story in my head: \"If I tell the truth, ___ will happen.\"\n6. What actually happened when I told the truth\n7. Tomorrow's risk moment, written as an if-then: \"If ___, then I'll say ___.\"\n8. One line of prayer or thanks")
  my addOne(24, "morning", "Day 24 Morning: Admit it first", "Week 4: Small Truths, Out Loud. Courage is a muscle. Train it light first.\n\nBefore anyone finds out, admit one small mistake today: \"That was me. I'll fix it.\"\n\nBefore you go, write today's if-then: \"If ___ happens, then I'll say ___.\"\n\nWhy it works: Shame hides. Guilt repairs. Day 11 teaches you to turn shame sentences into guilt sentences. You can repair something you did. You can't repair who you are. (Tangney & Dearing, Shame and Guilt (2002) and later reviews)")
  my addOne(24, "midday", "Day 24 Midday check", "Anything to correct since this morning? Correct it before 5 PM: \"Actually, that's not true. The truth is ___.\" Then log it tonight.")
  my addOne(24, "evening", "Day 24 Evening Ledger", "Tonight's question: How did it land? Compare what it cost with what you feared it would cost.\n\nTHE LEDGER (10 min)\n1. Lies told today (#): what, to whom\n2. Lies caught before I spoke (#)\n3. Corrections made (#)\n4. The trigger: who, where, how tired I was, and the fear (failure / rejection / conflict / looking weak)\n5. The story in my head: \"If I tell the truth, ___ will happen.\"\n6. What actually happened when I told the truth\n7. Tomorrow's risk moment, written as an if-then: \"If ___, then I'll say ___.\"\n8. One line of prayer or thanks")
  my addOne(25, "morning", "Day 25 Morning: Money and work", "Week 4: Small Truths, Out Loud. Courage is a muscle. Train it light first.\n\nMoney and work attract lies. Tell one true thing today about money or work that you've been fudging.\n\nBefore you go, write today's if-then: \"If ___ happens, then I'll say ___.\"\n\nWhy it works: Secrets weigh on you even when nobody is asking. The lies you're still carrying cost you every day, not just when you're questioned. That's part of why Week 5 plans a full disclosure. (Slepian, Chun & Mason (2017), Journal of Personality and Social Psychology)")
  my addOne(25, "midday", "Day 25 Midday check", "Anything to correct since this morning? Correct it before 5 PM: \"Actually, that's not true. The truth is ___.\" Then log it tonight.")
  my addOne(25, "evening", "Day 25 Evening Ledger", "Tonight's question: What's still hidden in money or work that needs to come out? Add it to the list for your inventory in Week 5.\n\nTHE LEDGER (10 min)\n1. Lies told today (#): what, to whom\n2. Lies caught before I spoke (#)\n3. Corrections made (#)\n4. The trigger: who, where, how tired I was, and the fear (failure / rejection / conflict / looking weak)\n5. The story in my head: \"If I tell the truth, ___ will happen.\"\n6. What actually happened when I told the truth\n7. Tomorrow's risk moment, written as an if-then: \"If ___, then I'll say ___.\"\n8. One line of prayer or thanks")
  my addOne(26, "morning", "Day 26 Morning: Climb a rung", "Week 4: Small Truths, Out Loud. Courage is a muscle. Train it light first.\n\nTell rung three or four of your ladder today.\n\nBefore you go, write today's if-then: \"If ___ happens, then I'll say ___.\"\n\nWhy it works: Lies are safety behaviors. Dropping them teaches you that the truth is survivable. Each lie you don't tell is a test of your prediction. The truth ladder (Week 4) and the prediction test (Day 12) are behavioral experiments. (Clark & Wells cognitive model; Morgan & Raffle (1999); Salkovskis)")
  my addOne(26, "midday", "Day 26 Midday check", "Anything to correct since this morning? Correct it before 5 PM: \"Actually, that's not true. The truth is ___.\" Then log it tonight.")
  my addOne(26, "evening", "Day 26 Evening Ledger", "Tonight's question: Rate your fear before and after. What's getting easier?\n\nTHE LEDGER (10 min)\n1. Lies told today (#): what, to whom\n2. Lies caught before I spoke (#)\n3. Corrections made (#)\n4. The trigger: who, where, how tired I was, and the fear (failure / rejection / conflict / looking weak)\n5. The story in my head: \"If I tell the truth, ___ will happen.\"\n6. What actually happened when I told the truth\n7. Tomorrow's risk moment, written as an if-then: \"If ___, then I'll say ___.\"\n8. One line of prayer or thanks")
  my addOne(27, "morning", "Day 27 Morning: Take the reaction", "Week 4: Small Truths, Out Loud. Courage is a muscle. Train it light first.\n\nBefore a hard conversation today, take two minutes to write about why your faith or your children matter to you. Then, when the truth gets a reaction (frustration, hurt, silence), don't defend, explain or lie again. Say: \"You're right to feel that.\"\n\nBefore you go, write today's if-then: \"If ___ happens, then I'll say ___.\"\n\nWhy it works: Remembering your values makes you less defensive. Before a hard conversation with your wife, spend two minutes writing about why your faith or your children matter to you. Then go listen. (Sherman & Cohen (2002), Current Directions in Psychological Science)")
  my addOne(27, "midday", "Day 27 Midday check", "Anything to correct since this morning? Correct it before 5 PM: \"Actually, that's not true. The truth is ___.\" Then log it tonight.")
  my addOne(27, "evening", "Day 27 Evening Ledger", "Tonight's question: Where did you want to defend yourself? What did you do instead?\n\nTHE LEDGER (10 min)\n1. Lies told today (#): what, to whom\n2. Lies caught before I spoke (#)\n3. Corrections made (#)\n4. The trigger: who, where, how tired I was, and the fear (failure / rejection / conflict / looking weak)\n5. The story in my head: \"If I tell the truth, ___ will happen.\"\n6. What actually happened when I told the truth\n7. Tomorrow's risk moment, written as an if-then: \"If ___, then I'll say ___.\"\n8. One line of prayer or thanks")
  my addOne(28, "morning", "Day 28 Morning: Week 4 review", "Week 4: Small Truths, Out Loud. Courage is a muscle. Train it light first.\n\nLook at your ladder. Mark every rung you've climbed.\n\nBefore you go, write today's if-then: \"If ___ happens, then I'll say ___.\"\n\nWhy it works: Tracking your behavior changes your behavior. The nightly ledger is the written record. The weekly text with your numbers to your accountability brother is the reporting. (Harkin et al. (2016), Psychological Bulletin)")
  my addOne(28, "midday", "Day 28 Midday check", "Anything to correct since this morning? Correct it before 5 PM: \"Actually, that's not true. The truth is ___.\" Then log it tonight.")
  my addOne(28, "review", "Week 4 review", "WEEKLY REVIEW (20 min)\nAdd up this week's ledgers: lies told, lies caught, corrections made. Text the three numbers to your brother. Share the week's patterns with your witness.\n\nNext week: Repair. This is the week the work turns toward your wife. It is done carefully, with your witness, following the disclosure plan, and never in pieces.")
  my addOne(28, "evening", "Day 28 Evening Ledger", "Tonight's question: Total the week and text your brother. Which truth did you think would wreck you but didn't?\n\nTHE LEDGER (10 min)\n1. Lies told today (#): what, to whom\n2. Lies caught before I spoke (#)\n3. Corrections made (#)\n4. The trigger: who, where, how tired I was, and the fear (failure / rejection / conflict / looking weak)\n5. The story in my head: \"If I tell the truth, ___ will happen.\"\n6. What actually happened when I told the truth\n7. Tomorrow's risk moment, written as an if-then: \"If ___, then I'll say ___.\"\n8. One line of prayer or thanks")
  my addOne(29, "morning", "Day 29 Morning: The inventory", "Week 5: Repair. Telling the truth is the start. Repair is the work.\n\nStart a private, written inventory of the lies that have affected your wife. Facts only, no excuses. Your witness sees it first. This is not a midnight confession.\n\nBefore you go, write today's if-then: \"If ___ happens, then I'll say ___.\"\n\nWhy it works: Secrets weigh on you even when nobody is asking. The lies you're still carrying cost you every day, not just when you're questioned. That's part of why Week 5 plans a full disclosure. (Slepian, Chun & Mason (2017), Journal of Personality and Social Psychology)")
  my addOne(29, "midday", "Day 29 Midday check", "Anything to correct since this morning? Correct it before 5 PM: \"Actually, that's not true. The truth is ___.\" Then log it tonight.")
  my addOne(29, "evening", "Day 29 Evening Ledger", "Tonight's question: What's the hardest item on the list? What do you fear will happen if she knows it?\n\nTHE LEDGER (10 min)\n1. Lies told today (#): what, to whom\n2. Lies caught before I spoke (#)\n3. Corrections made (#)\n4. The trigger: who, where, how tired I was, and the fear (failure / rejection / conflict / looking weak)\n5. The story in my head: \"If I tell the truth, ___ will happen.\"\n6. What actually happened when I told the truth\n7. Tomorrow's risk moment, written as an if-then: \"If ___, then I'll say ___.\"\n8. One line of prayer or thanks")
  my addOne(30, "morning", "Day 30 Morning: No trickle truth", "Week 5: Repair. Telling the truth is the start. Repair is the work.\n\nKnow this: telling the truth in pieces, a little more each time you're caught, does more damage than the original lie. Read the disclosure plan in this guide tonight, and set a date with your witness to go over your inventory.\n\nBefore you go, write today's if-then: \"If ___ happens, then I'll say ___.\"\n\nWhy it works: Full disclosure, with support, is usually seen as right afterward. Plan one full disclosure with your witness, using the disclosure plan in this guide (Week 5). Don't let it come out in pieces, and don't do it in a panic. (Schneider, Corley & Irons (1998), Sexual Addiction & Compulsivity)")
  my addOne(30, "midday", "Day 30 Midday check", "Anything to correct since this morning? Correct it before 5 PM: \"Actually, that's not true. The truth is ___.\" Then log it tonight.")
  my addOne(30, "evening", "Day 30 Evening Ledger", "Tonight's question: Have you set the date with your witness? If not, when exactly will you?\n\nTHE LEDGER (10 min)\n1. Lies told today (#): what, to whom\n2. Lies caught before I spoke (#)\n3. Corrections made (#)\n4. The trigger: who, where, how tired I was, and the fear (failure / rejection / conflict / looking weak)\n5. The story in my head: \"If I tell the truth, ___ will happen.\"\n6. What actually happened when I told the truth\n7. Tomorrow's risk moment, written as an if-then: \"If ___, then I'll say ___.\"\n8. One line of prayer or thanks")
  my addOne(31, "morning", "Day 31 Morning: Her side", "Week 5: Repair. Telling the truth is the start. Repair is the work.\n\nToday, try to see it from her side. What has it been like to live with a man whose word she couldn't count on?\n\nBefore you go, write today's if-then: \"If ___ happens, then I'll say ___.\"\n\nWhy it works: Couples therapy has tested models for repairing betrayal. Free and low-cost options come first: a church marriage ministry or marriage workshop, or a university training clinic. If you can afford it later, look for a couples therapist trained in EFT, the Gottman Method or affair recovery. (Makinen & Johnson (2006), Journal of Consulting and Clinical Psychology; Baucom, Snyder & Gordon)")
  my addOne(31, "midday", "Day 31 Midday check", "Anything to correct since this morning? Correct it before 5 PM: \"Actually, that's not true. The truth is ___.\" Then log it tonight.")
  my addOne(31, "evening", "Day 31 Evening Ledger", "Tonight's question: Write one page in her voice about what she has felt. Don't send it. Read it twice.\n\nTHE LEDGER (10 min)\n1. Lies told today (#): what, to whom\n2. Lies caught before I spoke (#)\n3. Corrections made (#)\n4. The trigger: who, where, how tired I was, and the fear (failure / rejection / conflict / looking weak)\n5. The story in my head: \"If I tell the truth, ___ will happen.\"\n6. What actually happened when I told the truth\n7. Tomorrow's risk moment, written as an if-then: \"If ___, then I'll say ___.\"\n8. One line of prayer or thanks")
  my addOne(32, "morning", "Day 32 Morning: A real apology", "Week 5: Repair. Telling the truth is the start. Repair is the work.\n\nA real apology has five parts: what I did, how it hurt you, no excuses, what I'm doing about it, and no demand to be forgiven. Draft one.\n\nBefore you go, write today's if-then: \"If ___ happens, then I'll say ___.\"\n\nWhy it works: Trust after lying comes back slowly, through actions. Set your expectations: this is a long road, and words won't carry you. Make small, specific promises and keep them exactly (Day 40). Never demand trust (Day 39). (Schweitzer, Hershey & Bradlow (2006), Organizational Behavior and Human Decision Processes)")
  my addOne(32, "midday", "Day 32 Midday check", "Anything to correct since this morning? Correct it before 5 PM: \"Actually, that's not true. The truth is ___.\" Then log it tonight.")
  my addOne(32, "evening", "Day 32 Evening Ledger", "Tonight's question: Read your draft and delete every \"but,\" \"if\" and \"I was just.\" What's left?\n\nTHE LEDGER (10 min)\n1. Lies told today (#): what, to whom\n2. Lies caught before I spoke (#)\n3. Corrections made (#)\n4. The trigger: who, where, how tired I was, and the fear (failure / rejection / conflict / looking weak)\n5. The story in my head: \"If I tell the truth, ___ will happen.\"\n6. What actually happened when I told the truth\n7. Tomorrow's risk moment, written as an if-then: \"If ___, then I'll say ___.\"\n8. One line of prayer or thanks")
  my addOne(33, "morning", "Day 33 Morning: Answer the whole question", "Week 5: Repair. Telling the truth is the start. Repair is the work.\n\nWhen she asks you something, answer it fully the first time. If you need time: \"I'll answer that fully. Give me until tonight.\" Then do it.\n\nBefore you go, write today's if-then: \"If ___ happens, then I'll say ___.\"\n\nWhy it works: Full disclosure, with support, is usually seen as right afterward. Plan one full disclosure with your witness, using the disclosure plan in this guide (Week 5). Don't let it come out in pieces, and don't do it in a panic. (Schneider, Corley & Irons (1998), Sexual Addiction & Compulsivity)")
  my addOne(33, "midday", "Day 33 Midday check", "Anything to correct since this morning? Correct it before 5 PM: \"Actually, that's not true. The truth is ___.\" Then log it tonight.")
  my addOne(33, "evening", "Day 33 Evening Ledger", "Tonight's question: Did you answer anything only partway today? Finish it.\n\nTHE LEDGER (10 min)\n1. Lies told today (#): what, to whom\n2. Lies caught before I spoke (#)\n3. Corrections made (#)\n4. The trigger: who, where, how tired I was, and the fear (failure / rejection / conflict / looking weak)\n5. The story in my head: \"If I tell the truth, ___ will happen.\"\n6. What actually happened when I told the truth\n7. Tomorrow's risk moment, written as an if-then: \"If ___, then I'll say ___.\"\n8. One line of prayer or thanks")
  my addOne(34, "morning", "Day 34 Morning: Repair with action", "Week 5: Repair. Telling the truth is the start. Repair is the work.\n\nPick one lie you can repair with action: return the money, keep the promise, finish the task. Do it today.\n\nBefore you go, write today's if-then: \"If ___ happens, then I'll say ___.\"\n\nWhy it works: Shame hides. Guilt repairs. Day 11 teaches you to turn shame sentences into guilt sentences. You can repair something you did. You can't repair who you are. (Tangney & Dearing, Shame and Guilt (2002) and later reviews)")
  my addOne(34, "midday", "Day 34 Midday check", "Anything to correct since this morning? Correct it before 5 PM: \"Actually, that's not true. The truth is ___.\" Then log it tonight.")
  my addOne(34, "evening", "Day 34 Evening Ledger", "Tonight's question: What did the repair cost you? Was it worth it?\n\nTHE LEDGER (10 min)\n1. Lies told today (#): what, to whom\n2. Lies caught before I spoke (#)\n3. Corrections made (#)\n4. The trigger: who, where, how tired I was, and the fear (failure / rejection / conflict / looking weak)\n5. The story in my head: \"If I tell the truth, ___ will happen.\"\n6. What actually happened when I told the truth\n7. Tomorrow's risk moment, written as an if-then: \"If ___, then I'll say ___.\"\n8. One line of prayer or thanks")
  my addOne(35, "morning", "Day 35 Morning: Week 5 review", "Week 5: Repair. Telling the truth is the start. Repair is the work.\n\nGo through the readiness checklist in the disclosure plan with your witness. Are you ready, and what's the date?\n\nBefore you go, write today's if-then: \"If ___ happens, then I'll say ___.\"\n\nWhy it works: Full disclosure, with support, is usually seen as right afterward. Plan one full disclosure with your witness, using the disclosure plan in this guide (Week 5). Don't let it come out in pieces, and don't do it in a panic. (Schneider, Corley & Irons (1998), Sexual Addiction & Compulsivity)")
  my addOne(35, "midday", "Day 35 Midday check", "Anything to correct since this morning? Correct it before 5 PM: \"Actually, that's not true. The truth is ___.\" Then log it tonight.")
  my addOne(35, "review", "Week 5 review", "WEEKLY REVIEW (20 min)\nAdd up this week's ledgers: lies told, lies caught, corrections made. Text the three numbers to your brother. Share the week's patterns with your witness.\n\nNext week: Transparency. She can't trust your words yet, so give her things she can check. Trust comes back through small, verifiable, repeated evidence.")
  my addOne(35, "evening", "Day 35 Evening Ledger", "Tonight's question: Total the week and text your brother. What has repair taught you that confession alone couldn't?\n\nTHE LEDGER (10 min)\n1. Lies told today (#): what, to whom\n2. Lies caught before I spoke (#)\n3. Corrections made (#)\n4. The trigger: who, where, how tired I was, and the fear (failure / rejection / conflict / looking weak)\n5. The story in my head: \"If I tell the truth, ___ will happen.\"\n6. What actually happened when I told the truth\n7. Tomorrow's risk moment, written as an if-then: \"If ___, then I'll say ___.\"\n8. One line of prayer or thanks")
  my addOne(36, "morning", "Day 36 Morning: Get ahead of it", "Week 6: Transparency. Trust is rebuilt on boring days.\n\nTell her something before she asks: your schedule, a purchase, a mistake.\n\nBefore you go, write today's if-then: \"If ___ happens, then I'll say ___.\"\n\nWhy it works: Trust after lying comes back slowly, through actions. Set your expectations: this is a long road, and words won't carry you. Make small, specific promises and keep them exactly (Day 40). Never demand trust (Day 39). (Schweitzer, Hershey & Bradlow (2006), Organizational Behavior and Human Decision Processes)")
  my addOne(36, "midday", "Day 36 Midday check", "Anything to correct since this morning? Correct it before 5 PM: \"Actually, that's not true. The truth is ___.\" Then log it tonight.")
  my addOne(36, "evening", "Day 36 Evening Ledger", "Tonight's question: What did you volunteer? How did it feel to be ahead of the truth instead of behind it?\n\nTHE LEDGER (10 min)\n1. Lies told today (#): what, to whom\n2. Lies caught before I spoke (#)\n3. Corrections made (#)\n4. The trigger: who, where, how tired I was, and the fear (failure / rejection / conflict / looking weak)\n5. The story in my head: \"If I tell the truth, ___ will happen.\"\n6. What actually happened when I told the truth\n7. Tomorrow's risk moment, written as an if-then: \"If ___, then I'll say ___.\"\n8. One line of prayer or thanks")
  my addOne(37, "morning", "Day 37 Morning: Open book", "Week 6: Transparency. Trust is rebuilt on boring days.\n\nOffer access without being asked: phone, accounts, calendar, whatever was hidden before. Offer it as evidence, not as punishment.\n\nBefore you go, write today's if-then: \"If ___ happens, then I'll say ___.\"\n\nWhy it works: Trust after lying comes back slowly, through actions. Set your expectations: this is a long road, and words won't carry you. Make small, specific promises and keep them exactly (Day 40). Never demand trust (Day 39). (Schweitzer, Hershey & Bradlow (2006), Organizational Behavior and Human Decision Processes)")
  my addOne(37, "midday", "Day 37 Midday check", "Anything to correct since this morning? Correct it before 5 PM: \"Actually, that's not true. The truth is ___.\" Then log it tonight.")
  my addOne(37, "evening", "Day 37 Evening Ledger", "Tonight's question: What are you still keeping in a back room?\n\nTHE LEDGER (10 min)\n1. Lies told today (#): what, to whom\n2. Lies caught before I spoke (#)\n3. Corrections made (#)\n4. The trigger: who, where, how tired I was, and the fear (failure / rejection / conflict / looking weak)\n5. The story in my head: \"If I tell the truth, ___ will happen.\"\n6. What actually happened when I told the truth\n7. Tomorrow's risk moment, written as an if-then: \"If ___, then I'll say ___.\"\n8. One line of prayer or thanks")
  my addOne(38, "morning", "Day 38 Morning: Her anger isn't the enemy", "Week 6: Transparency. Trust is rebuilt on boring days.\n\nIf she's hurt or angry today, it's the cost of what happened, not an attack on you. Before you talk, take two minutes to remember what kind of husband you've decided to be. Then stay in the room, listen, and don't argue about the facts.\n\nBefore you go, write today's if-then: \"If ___ happens, then I'll say ___.\"\n\nWhy it works: Remembering your values makes you less defensive. Before a hard conversation with your wife, spend two minutes writing about why your faith or your children matter to you. Then go listen. (Sherman & Cohen (2002), Current Directions in Psychological Science)")
  my addOne(38, "midday", "Day 38 Midday check", "Anything to correct since this morning? Correct it before 5 PM: \"Actually, that's not true. The truth is ___.\" Then log it tonight.")
  my addOne(38, "evening", "Day 38 Evening Ledger", "Tonight's question: Did you stay? At what moment did you want to leave?\n\nTHE LEDGER (10 min)\n1. Lies told today (#): what, to whom\n2. Lies caught before I spoke (#)\n3. Corrections made (#)\n4. The trigger: who, where, how tired I was, and the fear (failure / rejection / conflict / looking weak)\n5. The story in my head: \"If I tell the truth, ___ will happen.\"\n6. What actually happened when I told the truth\n7. Tomorrow's risk moment, written as an if-then: \"If ___, then I'll say ___.\"\n8. One line of prayer or thanks")
  my addOne(39, "morning", "Day 39 Morning: Don't demand trust", "Week 6: Transparency. Trust is rebuilt on boring days.\n\nDon't ask \"When are you going to trust me?\" Research on trust after deception shows it comes back slowly and through actions, not words. Whether she trusts you is her decision. Being consistent is yours.\n\nBefore you go, write today's if-then: \"If ___ happens, then I'll say ___.\"\n\nWhy it works: Trust after lying comes back slowly, through actions. Set your expectations: this is a long road, and words won't carry you. Make small, specific promises and keep them exactly (Day 40). Never demand trust (Day 39). (Schweitzer, Hershey & Bradlow (2006), Organizational Behavior and Human Decision Processes)")
  my addOne(39, "midday", "Day 39 Midday check", "Anything to correct since this morning? Correct it before 5 PM: \"Actually, that's not true. The truth is ___.\" Then log it tonight.")
  my addOne(39, "evening", "Day 39 Evening Ledger", "Tonight's question: What did you do today that she could check for herself?\n\nTHE LEDGER (10 min)\n1. Lies told today (#): what, to whom\n2. Lies caught before I spoke (#)\n3. Corrections made (#)\n4. The trigger: who, where, how tired I was, and the fear (failure / rejection / conflict / looking weak)\n5. The story in my head: \"If I tell the truth, ___ will happen.\"\n6. What actually happened when I told the truth\n7. Tomorrow's risk moment, written as an if-then: \"If ___, then I'll say ___.\"\n8. One line of prayer or thanks")
  my addOne(40, "morning", "Day 40 Morning: Keep one small promise", "Week 6: Transparency. Trust is rebuilt on boring days.\n\nMake one small, specific promise with a time on it, and keep it exactly.\n\nBefore you go, write today's if-then: \"If ___ happens, then I'll say ___.\"\n\nWhy it works: If-then plans work. Every morning you write one if-then plan for the day's risk moment: \"If she asks about the money, then I'll say the real number.\" (Gollwitzer & Sheeran (2006), Advances in Experimental Social Psychology)")
  my addOne(40, "midday", "Day 40 Midday check", "Anything to correct since this morning? Correct it before 5 PM: \"Actually, that's not true. The truth is ___.\" Then log it tonight.")
  my addOne(40, "evening", "Day 40 Evening Ledger", "Tonight's question: Did you keep it, on time? Small promises kept are how your words become believable again.\n\nTHE LEDGER (10 min)\n1. Lies told today (#): what, to whom\n2. Lies caught before I spoke (#)\n3. Corrections made (#)\n4. The trigger: who, where, how tired I was, and the fear (failure / rejection / conflict / looking weak)\n5. The story in my head: \"If I tell the truth, ___ will happen.\"\n6. What actually happened when I told the truth\n7. Tomorrow's risk moment, written as an if-then: \"If ___, then I'll say ___.\"\n8. One line of prayer or thanks")
  my addOne(41, "morning", "Day 41 Morning: Say the feeling", "Week 6: Transparency. Trust is rebuilt on boring days.\n\nMany lies stand in for feelings. Today, say one feeling out loud: \"I'm afraid.\" \"I'm embarrassed.\" \"I'm stressed about money.\"\n\nBefore you go, write today's if-then: \"If ___ happens, then I'll say ___.\"\n\nWhy it works: Writing about hard things helps a little. The evening questions and letters are writing exercises. They help, but they're one tool among several, not a cure. (Frattaroli (2006), Psychological Bulletin)")
  my addOne(41, "midday", "Day 41 Midday check", "Anything to correct since this morning? Correct it before 5 PM: \"Actually, that's not true. The truth is ___.\" Then log it tonight.")
  my addOne(41, "evening", "Day 41 Evening Ledger", "Tonight's question: What feeling did you finally say? What happened next?\n\nTHE LEDGER (10 min)\n1. Lies told today (#): what, to whom\n2. Lies caught before I spoke (#)\n3. Corrections made (#)\n4. The trigger: who, where, how tired I was, and the fear (failure / rejection / conflict / looking weak)\n5. The story in my head: \"If I tell the truth, ___ will happen.\"\n6. What actually happened when I told the truth\n7. Tomorrow's risk moment, written as an if-then: \"If ___, then I'll say ___.\"\n8. One line of prayer or thanks")
  my addOne(42, "morning", "Day 42 Morning: Week 6 review", "Week 6: Transparency. Trust is rebuilt on boring days.\n\nAsk your wife one question today, and only if she's open to it: \"What's one thing that would help you feel safer with me this week?\" Just listen.\n\nBefore you go, write today's if-then: \"If ___ happens, then I'll say ___.\"\n\nWhy it works: Couples therapy has tested models for repairing betrayal. Free and low-cost options come first: a church marriage ministry or marriage workshop, or a university training clinic. If you can afford it later, look for a couples therapist trained in EFT, the Gottman Method or affair recovery. (Makinen & Johnson (2006), Journal of Consulting and Clinical Psychology; Baucom, Snyder & Gordon)")
  my addOne(42, "midday", "Day 42 Midday check", "Anything to correct since this morning? Correct it before 5 PM: \"Actually, that's not true. The truth is ___.\" Then log it tonight.")
  my addOne(42, "review", "Week 6 review", "WEEKLY REVIEW (20 min)\nAdd up this week's ledgers: lies told, lies caught, corrections made. Text the three numbers to your brother. Share the week's patterns with your witness.\n\nNext week: A Man Whose Word Holds. You finish by deciding who you are, planning for the day you slip, and choosing what keeps running after Day 49.")
  my addOne(42, "evening", "Day 42 Evening Ledger", "Tonight's question: Total the week and text your brother. What did she tell you, and what will you do about it?\n\nTHE LEDGER (10 min)\n1. Lies told today (#): what, to whom\n2. Lies caught before I spoke (#)\n3. Corrections made (#)\n4. The trigger: who, where, how tired I was, and the fear (failure / rejection / conflict / looking weak)\n5. The story in my head: \"If I tell the truth, ___ will happen.\"\n6. What actually happened when I told the truth\n7. Tomorrow's risk moment, written as an if-then: \"If ___, then I'll say ___.\"\n8. One line of prayer or thanks")
  my addOne(43, "morning", "Day 43 Morning: Your identity sentence", "Week 7: A Man Whose Word Holds. Not a streak. An identity.\n\nRewrite your vision sentence: \"I am a man who tells the truth when it costs me.\" Read it three times this morning.\n\nBefore you go, write today's if-then: \"If ___ happens, then I'll say ___.\"\n\nWhy it works: Remembering your values makes you less defensive. Before a hard conversation with your wife, spend two minutes writing about why your faith or your children matter to you. Then go listen. (Sherman & Cohen (2002), Current Directions in Psychological Science)")
  my addOne(43, "midday", "Day 43 Midday check", "Anything to correct since this morning? Correct it before 5 PM: \"Actually, that's not true. The truth is ___.\" Then log it tonight.")
  my addOne(43, "evening", "Day 43 Evening Ledger", "Tonight's question: Where did you live that sentence today?\n\nTHE LEDGER (10 min)\n1. Lies told today (#): what, to whom\n2. Lies caught before I spoke (#)\n3. Corrections made (#)\n4. The trigger: who, where, how tired I was, and the fear (failure / rejection / conflict / looking weak)\n5. The story in my head: \"If I tell the truth, ___ will happen.\"\n6. What actually happened when I told the truth\n7. Tomorrow's risk moment, written as an if-then: \"If ___, then I'll say ___.\"\n8. One line of prayer or thanks")
  my addOne(44, "morning", "Day 44 Morning: Your warning signs", "Week 7: A Man Whose Word Holds. Not a streak. An identity.\n\nWrite your relapse warning signs: short on sleep, stressed, money trouble, isolated, skipping the ledger, keeping \"small\" secrets, rounding up again.\n\nBefore you go, write today's if-then: \"If ___ happens, then I'll say ___.\"\n\nWhy it works: Tired men have less self-control. Treat being tired as a risk factor. Your evening ledger and your relapse warning signs include sleep. (Barnes, Schaubroeck, Huth & Ghumman (2011), Organizational Behavior and Human Decision Processes)")
  my addOne(44, "midday", "Day 44 Midday check", "Anything to correct since this morning? Correct it before 5 PM: \"Actually, that's not true. The truth is ___.\" Then log it tonight.")
  my addOne(44, "evening", "Day 44 Evening Ledger", "Tonight's question: Which warning sign is showing right now?\n\nTHE LEDGER (10 min)\n1. Lies told today (#): what, to whom\n2. Lies caught before I spoke (#)\n3. Corrections made (#)\n4. The trigger: who, where, how tired I was, and the fear (failure / rejection / conflict / looking weak)\n5. The story in my head: \"If I tell the truth, ___ will happen.\"\n6. What actually happened when I told the truth\n7. Tomorrow's risk moment, written as an if-then: \"If ___, then I'll say ___.\"\n8. One line of prayer or thanks")
  my addOne(45, "morning", "Day 45 Morning: Your relapse plan", "Week 7: A Man Whose Word Holds. Not a streak. An identity.\n\nWrite it and sign it: If I lie, I will 1) correct it the same day, 2) log it, 3) write myself two honest, kind sentences instead of tearing myself down, 4) tell my brother within 24 hours, 5) tell my witness at our next talk. I don't start over at Day 1.\n\nBefore you go, write today's if-then: \"If ___ happens, then I'll say ___.\"\n\nWhy it works: A slip doesn't have to become a relapse. If you lie, you correct it, log it, tell your brother, and keep going. You never go back to Day 1. (Marlatt & Gordon, Relapse Prevention; Larimer, Palmer & Marlatt (1999))")
  my addOne(45, "midday", "Day 45 Midday check", "Anything to correct since this morning? Correct it before 5 PM: \"Actually, that's not true. The truth is ___.\" Then log it tonight.")
  my addOne(45, "evening", "Day 45 Evening Ledger", "Tonight's question: Who has a copy? Send it to your brother tonight.\n\nTHE LEDGER (10 min)\n1. Lies told today (#): what, to whom\n2. Lies caught before I spoke (#)\n3. Corrections made (#)\n4. The trigger: who, where, how tired I was, and the fear (failure / rejection / conflict / looking weak)\n5. The story in my head: \"If I tell the truth, ___ will happen.\"\n6. What actually happened when I told the truth\n7. Tomorrow's risk moment, written as an if-then: \"If ___, then I'll say ___.\"\n8. One line of prayer or thanks")
  my addOne(46, "morning", "Day 46 Morning: Teach it", "Week 7: A Man Whose Word Holds. Not a streak. An identity.\n\nHow you handle your own mistakes teaches your kids how to handle theirs. Admit a mistake in front of them today, in a way that fits their age.\n\nBefore you go, write today's if-then: \"If ___ happens, then I'll say ___.\"\n\nWhy it works: Lying less goes with better health and relationships. The payoff of this work isn't only your marriage. You should also start to feel better. (Kelly & Wang (2012), American Psychological Association convention)")
  my addOne(46, "midday", "Day 46 Midday check", "Anything to correct since this morning? Correct it before 5 PM: \"Actually, that's not true. The truth is ___.\" Then log it tonight.")
  my addOne(46, "evening", "Day 46 Evening Ledger", "Tonight's question: What do you want your children to learn about truth from watching you?\n\nTHE LEDGER (10 min)\n1. Lies told today (#): what, to whom\n2. Lies caught before I spoke (#)\n3. Corrections made (#)\n4. The trigger: who, where, how tired I was, and the fear (failure / rejection / conflict / looking weak)\n5. The story in my head: \"If I tell the truth, ___ will happen.\"\n6. What actually happened when I told the truth\n7. Tomorrow's risk moment, written as an if-then: \"If ___, then I'll say ___.\"\n8. One line of prayer or thanks")
  my addOne(47, "morning", "Day 47 Morning: What the truth gave you", "Week 7: A Man Whose Word Holds. Not a streak. An identity.\n\nList five things that seven weeks of truth have given you.\n\nBefore you go, write today's if-then: \"If ___ happens, then I'll say ___.\"\n\nWhy it works: Self-compassion makes men more likely to make amends. Beating yourself up feeds shame, and shame feeds hiding. After a slip, you write yourself two honest, kind sentences, then you go fix it. (Breines & Chen (2012), Personality and Social Psychology Bulletin)")
  my addOne(47, "midday", "Day 47 Midday check", "Anything to correct since this morning? Correct it before 5 PM: \"Actually, that's not true. The truth is ___.\" Then log it tonight.")
  my addOne(47, "evening", "Day 47 Evening Ledger", "Tonight's question: Thank your wife for one specific thing she has done during this. Thank God for one too.\n\nTHE LEDGER (10 min)\n1. Lies told today (#): what, to whom\n2. Lies caught before I spoke (#)\n3. Corrections made (#)\n4. The trigger: who, where, how tired I was, and the fear (failure / rejection / conflict / looking weak)\n5. The story in my head: \"If I tell the truth, ___ will happen.\"\n6. What actually happened when I told the truth\n7. Tomorrow's risk moment, written as an if-then: \"If ___, then I'll say ___.\"\n8. One line of prayer or thanks")
  my addOne(48, "morning", "Day 48 Morning: Your ongoing system", "Week 7: A Man Whose Word Holds. Not a streak. An identity.\n\nDecide what keeps running after Day 49. Keep: the nightly ledger, the weekly review, a weekly text to your brother, and regular talks with your witness or your group. Optional: the midday check.\n\nBefore you go, write today's if-then: \"If ___ happens, then I'll say ___.\"\n\nWhy it works: Tracking your behavior changes your behavior. The nightly ledger is the written record. The weekly text with your numbers to your accountability brother is the reporting. (Harkin et al. (2016), Psychological Bulletin)")
  my addOne(48, "midday", "Day 48 Midday check", "Anything to correct since this morning? Correct it before 5 PM: \"Actually, that's not true. The truth is ___.\" Then log it tonight.")
  my addOne(48, "evening", "Day 48 Evening Ledger", "Tonight's question: Set those reminders for the next 90 days before you sleep.\n\nTHE LEDGER (10 min)\n1. Lies told today (#): what, to whom\n2. Lies caught before I spoke (#)\n3. Corrections made (#)\n4. The trigger: who, where, how tired I was, and the fear (failure / rejection / conflict / looking weak)\n5. The story in my head: \"If I tell the truth, ___ will happen.\"\n6. What actually happened when I told the truth\n7. Tomorrow's risk moment, written as an if-then: \"If ___, then I'll say ___.\"\n8. One line of prayer or thanks")
  my addOne(49, "morning", "Day 49 Morning: Day 49", "Week 7: A Man Whose Word Holds. Not a streak. An identity.\n\nRead your Day 1 numbers this morning.\n\nBefore you go, write today's if-then: \"If ___ happens, then I'll say ___.\"\n\nWhy it works: Self-compassion makes men more likely to make amends. Beating yourself up feeds shame, and shame feeds hiding. After a slip, you write yourself two honest, kind sentences, then you go fix it. (Breines & Chen (2012), Personality and Social Psychology Bulletin)")
  my addOne(49, "midday", "Day 49 Midday check", "Anything to correct since this morning? Correct it before 5 PM: \"Actually, that's not true. The truth is ___.\" Then log it tonight.")
  my addOne(49, "review", "Week 7 review", "WEEKLY REVIEW (20 min)\nAdd up this week's ledgers: lies told, lies caught, corrections made. Text the three numbers to your brother. Share the week's patterns with your witness.\n\nYou made it to Day 49. Decide what keeps running from here.")
  my addOne(49, "evening", "Day 49 Evening Ledger", "Tonight's question: Write a letter to the man who started on Day 1. Then tell your wife one thing you've learned about yourself.\n\nTHE LEDGER (10 min)\n1. Lies told today (#): what, to whom\n2. Lies caught before I spoke (#)\n3. Corrections made (#)\n4. The trigger: who, where, how tired I was, and the fear (failure / rejection / conflict / looking weak)\n5. The story in my head: \"If I tell the truth, ___ will happen.\"\n6. What actually happened when I told the truth\n7. Tomorrow's risk moment, written as an if-then: \"If ___, then I'll say ___.\"\n8. One line of prayer or thanks")
  -- Day 50: set up the next 90 days
  my addOne(50, "review", "Day 50 Keep it running", "Set your ongoing reminders: nightly ledger, weekly review, weekly text to your brother. A streak ends. An identity keeps going.")
end run
APPLESCRIPT

echo "Done. Open Reminders and find \"$LIST\". Your first reminder (Day 0) goes off in 10 minutes."
