# --- Claude ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5

# --- Safety: leave true until you've reviewed a week of /admin/log output ---
DRY_RUN=true

# --- Meta (Instagram + Facebook) ---
META_APP_SECRET=
META_VERIFY_TOKEN=pick-any-long-random-string
META_PAGE_TOKEN=            # long-lived Page access token
FB_PAGE_ID=
IG_USER_ID=                 # Instagram professional account id
IG_USERNAME=                # without the @, used to skip your own comments
GRAPH_VERSION=v21.0

# --- Behaviour ---
POLL_INTERVAL_SECONDS=120   # 0 disables polling (webhooks only)
MIN_DELAY_SECONDS=30
MAX_DELAY_SECONDS=120
MAX_REPLIES_PER_DAY=150
WELCOME_DM_ENABLED=false    # private-reply DM to first-time commenters
CONTACT_EMAIL=you@example.com

# --- Ops ---
ADMIN_TOKEN=                # required to read /admin/log
NOTIFY_WEBHOOK_URL=         # Slack-compatible webhook for flagged comments
DB_PATH=data/community.db
